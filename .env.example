# ============================================================
#  Environment configuration (copy to .env and fill in)
#  Never commit .env — it is git-ignored.
# ============================================================

# --- LLM (OpenAI-compatible) ---
# Default: DeepSeek (hosted, OpenAI-compatible). Called directly over HTTPS,
# so no host.docker.internal needed.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-REPLACE_ME          # paste your real DeepSeek key in .env (never commit it)
LLM_MODEL=deepseek-chat
# Context window handed to LlamaIndex (OpenAILike defaults to 3900, which would
# truncate RAG context). DeepSeek supports 64K; lower it for tiny local models.
LLM_CONTEXT_WINDOW=64000
#
# To switch back to a local llamafile on the host instead (Linux reaches the
# host via host.docker.internal — see docker-compose extra_hosts), comment the
# three DeepSeek lines above and uncomment these:
# LLM_BASE_URL=http://host.docker.internal:8080/v1
# LLM_API_KEY=not-needed
# LLM_MODEL=local-model
# LLM_CONTEXT_WINDOW=4096

# --- Embeddings (must stay multilingual — do NOT swap for English-only) ---
EMBED_MODEL=BAAI/bge-m3

# --- ChromaDB ---
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION=support_kb

# --- Database ---
DATABASE_URL=postgresql+psycopg://support:support@postgres:5432/support

# --- Auth / JWT ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxx
EMAIL_FROM=noreply@yourdomain.com
APP_URL=http://localhost:5173

# --- Payments (Dodo) ---
DODO_API_KEY=xxxxx
DODO_WEBHOOK_SECRET=whsec_xxxxx
DODO_PRO_PRODUCT_ID=prod_xxxxx
DODO_API_BASE=https://test.dodopayments.com

# --- Backend / CORS ---
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
